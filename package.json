{
  "name": "edward-mccann",
  "version": "0.1.0",
  "private": true,
  "description": "Edward McCann Architecture website",
  "scripts": {
    "dev": "doppler run --project edward-mccann --config dev -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "content:figures": "node tools/extract-figures.mjs",
    "content:text": "node tools/build-text.mjs",
    "media:publish": "doppler run --project edward-mccann --config dev -- node tools/prepare-media.mjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "sharp": "^0.35.3",
    "typescript": "^5"
  }
}
